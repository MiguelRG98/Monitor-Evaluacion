# 0. Leer librerías.
Sys.setlocale("LC_TIME", "es_ES.UTF-8")
library(pacman)
p_load("tidyverse", "plotly", "flexdashboard", "reactable", "openxlsx", "hrbrthemes", "scales", "jsonlite",
"janitor", "stringr", "stringi", "usethis", "crosstalk",
"sf", "rmapshaper", "ggmagnify", "stringdist")
# 1. Enlace para tener datos actualizados 'todo el tiempo'.
url_fao_data <- "https://docs.google.com/spreadsheets/d/e/2PACX-1vSGcdqxColk_BnF7NgrgP6hzUnkFmA-rQfPE6ptC8FsLWPYzXoqq_2TCdnTj8Cm5l2POt0Lmf9YaXwW/pub?output=xlsx"
# 2. Descarga de datos en tiempo real
df <- read.xlsx(url_fao_data) |>
clean_names() |>
# Generar columnas auxiliares
mutate(treatment = ifelse(en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "No, no las he tomado", 0, 1),
modalidad = case_when(en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "No, no las he tomado" ~ "Sin capacitación",
en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "Sí, presencialmente" ~ "Presencialmente",
en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "Sí, virtualmente" ~ "Virtualmente",
en_los_ultimos_seis_meses_ha_tomado_las_capacitaciones_sobre_estadistica_agricola_o_pecuaria_presencial_o_virtualmente == "Sí, de las 2 formas" ~ "Híbrido"))
# Identificar respuesta correcta por pregunta.
df <-  df |>
mutate(nombre_del_cader_ddr_u_oref_donde_labora =
str_trim(toupper(stri_trans_general(nombre_del_cader_ddr_u_oref_donde_labora, "latin-ascii"))),
p_1= ifelse(el_rendimiento_obtenido_se_expresa_en_kilogramos_por_hectareas=="Falso",1,0),
p_2= ifelse(la_variable_valor_de_la_produccion_se_captura_manualmente_en_el_sistema_raw=="Falso",1,0),
p_3= ifelse(cuando_existe_una_diferencia_notable_entre_el_precio_de_venta_reportado_directamente_por_un_productor_en_su_parcela_y_el_precio_de_ese_mismo_producto_en_la_central_de_abastos_local_cual_es_el_criterio_para_registrar_el_precio_medio_rural_pmr=="Registrar el precio del productor, ya que el PMR se refiere al precio pagado en la zona de producción (primera mano), sin incluir costos de flete o intermediación",1,0),
p_4= ifelse(la_superficie_siniestrada_del_mes_puede_ser_mayor_a_la_superficie_sembrada=="Falso",1,0),
p_5= ifelse(en_el_programa_agricola_se_registran_las_expectativas_de_siembra_y_cosecha_antes_del_inicio_del_ciclo_agricola=="Verdadero",1,0),
p_6= ifelse(cual_de_las_siguientes_variables_es_formulada_automaticamente_por_el_sistema=="c) Rendimiento obtenido",1,0),
p_7= ifelse(que_apartado_del_sistema_raw_se_utiliza_para_revisar_si_existen_capturas_pendientes=="b) Validación de Completez",1,0),
p_8= ifelse(cual_de_los_siguientes_motivos_es_valido_para_dar_de_baja_un_cultivo=="d) Todas las anteriores",1,0),
p_9= ifelse(quien_es_el_principal_usuario_de_la_estadistica_agricola_y_pecuaria_registrada_en_la_raw=="La propia Secretaría de Agricultura del Gobierno Federal",1,0),
p_10= ifelse(la_superficie_sembrada_debe_ser_mayor_o_igual_que=="Superficie cosechada y siniestrada",1,0),
p_11= ifelse(en_que_categoria_o_grupo_se_debe_clasificar_la_alfalfa_para_su_correcto_registro_en_el_sistema=="Perennes especiales",1,0),
p_12= ifelse(el_precio_a_pie_de_granja_o_pagado_al_productor_es_el_precio_mas_barato_al_que_se_puede_comprar_un_producto=="Falso",1,0),
p_13= ifelse(los_parametros_productivos_indican_un_maximo_y_un_minimo_y_no_puede_haber_datos_fuera_de_este_rango_bajo_ninguna_circunstancia=="Falso",1,0),
p_14= ifelse(solo_debe_registrarse_informacion_proveniente_de_senasica_rastros_municipales_entre_otras_instituciones=="Falso",1,0),
p_15= ifelse(el_valor_de_la_produccion_se_obtiene_multiplicando_el_volumen_por_el_precio_promedio_encontrado_en_los_mercados_locales=="Falso",1,0),
p_16= ifelse(el_sistema_productivo_tecnificado_se_caracteriza_por_bajo_uso_de_tecnologia_y_mano_de_obra_familiar=="Falso",1,0),
p_17= ifelse(en_que_unidades_se_registra_la_leche=="Miles de litros",1,0),
p_18= ifelse(cual_de_los_siguientes_sistemas_productivos_es_mas_probable_que_tenga_un_mayor_rendimiento_productivo=="Especializado",1,0),
p_19= ifelse(cual_de_las_siguientes_caracteristicas_debe_cumplir_la_carne_en_canal_de_bovino_selecciona_todas_las_opciones_que_apliquen=="Desangrado y sin piel, Abierto a lo largo de la línea media, Separado de la cabeza por el cuello, Sin vísceras, excepto los riñones; quedando el diafragma adherido",1,0),
p_20= ifelse(cual_opcion_describe_mejor_el_ganado_en_engorda=="Animales cuya función zootécnica es la producción de carne",1,0),
p_21= ifelse(cual_es_la_formula_correcta_para_calcular_el_volumen_total_en_pie=="(Número de cabezas x peso promedio en pie)/1000",1,0),
p_22= ifelse(si_al_revisar_la_informacion_de_un_rastro_municipal_notas_que_el_peso_promedio_por_cabeza_de_los_bovinos_sacrificados_aumento_drasticamente_respecto_al_mes_anterior_cual_es_la_accion_de_validacion_correcta_antes_de_capturar=="Investigar con los productores o el rastro si hubo introducción de razas de mayor peso, cambios en la dieta o engorda, y justificarlo en las observaciones del sistema",1,0))
# Evaluar preguntas por separado
df <- df |>
mutate(agricola = rowSums(pick(p_1:p_11), na.rm = T),
pecuario = rowSums(pick(p_12:p_22), na.rm = T))
# Modificar calificaciones para hacerlas sobre 10-----
df <- df |>
mutate(score = round((score/22)*10, 1),
agricola = round(agricola/11*10, 1),
pecuario = round(pecuario/11*10, 1))
# Identify people of each CADER----
## Loop to identify CADER Adscription----
caders <- read.xlsx("/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/Scripts/Bases/20072025 BASE DATOS 1.xlsx",
startRow = 10) |>
clean_names() |>
mutate(entidad_federativa = str_to_sentence(estado),
longitud=as.numeric(longitud),
entidad_federativa = case_when(entidad_federativa=="Michoacan de ocampo" ~ "Michoacán de Ocampo",
entidad_federativa=="San luis potosi" ~ "San Luis Potosí",
entidad_federativa=="Nuevo leon" ~ "Nuevo León",
entidad_federativa=="Baja california" ~ "Baja California",
entidad_federativa=="Quintana roo" ~ "Quintana Roo",
entidad_federativa=="Queretaro" ~ "Querétaro de Arteaga",
entidad_federativa=="Coahuila de zaragoza" ~ "Coahuila de Zaragoza",
entidad_federativa=="Mexico" ~ "México",
entidad_federativa=="Yucatan" ~ "Yucatán",
entidad_federativa=="Veracruz de ignacio de la llave" ~ "Veracruz de Ignacio de la Llave",
entidad_federativa=="Baja california sur" ~ "Baja California Sur",
entidad_federativa=="Ciudad de mexico" ~ "Ciudad de México",
entidad_federativa=="Quintana roo" ~ "Quintanta Roo",
.default = entidad_federativa
))
caders <- caders |>
distinct(estado, nombre_del_ddr, nombre_del_cader_vs_cab, longitud, latitud, entidad_federativa, sigla_edo_of_rep) |>
mutate(across(c(estado, nombre_del_cader_vs_cab), \(x) stri_trans_general(toupper(str_trim(x)), "latin-ascii")))
palabras_clave <- "CADER|DISTRITO|CENTRO DE APOYO AL DESARROLLO RURAL|DISTRITO DE DESARROLLO RURAL"
patron_regex <- str_glue("^(?:(?i)(?:{palabras_clave})\\s*\\d*|[^a-zA-ZÁ-ÿÑñ]*)[, .\\s]*(.*?)(?:\\b(?:DEL\\s+)?DDR\\b|\\bOREF\\b|[,.]|$)")
df_np <- df |>
mutate(nom_cader = stri_trans_general(toupper(str_trim(nombre_del_cader_ddr_u_oref_donde_labora)), "latin-ascii"),
entidad_federativa = stri_trans_general(toupper(str_trim(entidad_federativa)), "latin-ascii")) |>
distinct(entidad_federativa, lugar_de_trabajo, nom_cader, email_address) |>
#filter(lugar_de_trabajo=="CADER") |>
mutate(
# Intento A (el original basado en CADER)
intento_cader = str_match(
nom_cader,
"(?i)CADER\\s*\\d*\\s*(.*?)(?:\\b(?:DEL\\s+)?DDR\\b|\\bOREF\\b|[,.]|$)"
)[, 2],
intento_directo = str_match(nom_cader, patron_regex)[, 2],
# Validamos que tengan letras reales, si no, se hacen NA
intento_cader = if_else(str_detect(intento_cader, "^[^a-zA-ZÁ-ÿÑñ]*$"), NA_character_, intento_cader),
intento_directo = if_else(str_detect(intento_directo, "^[^a-zA-ZÁ-ÿÑñ]*$"), NA_character_, intento_directo),
# Fusionamos
extraido = coalesce(intento_cader, intento_directo),
# Limpieza extrema final
extraido = str_remove(extraido, "^[^a-zA-ZÁ-ÿÑñ]+"),
extraido = str_remove(extraido, "^(?i)[a-z]['’\\s]+\\s*"),
extraido = str_remove_all(extraido, "\\b\\d+\\b"),
extraido = str_squish(extraido),
# Si queda huérfana alguna palabra clave tras la limpieza, la hacemos NA
extraido = if_else(extraido == "" | is.na(extraido) | toupper(extraido) %in% c("CADER", "DISTRITO"), NA_character_, extraido)
) %>%
# Modificar nombres de estados
mutate(entidad_federativa = case_when(entidad_federativa=="QUERETARO DE ARTEAGA" ~ "QUERETARO",
.default = entidad_federativa),
aux = ifelse(lugar_de_trabajo == "CADER" | str_detect(nom_cader, pattern = "CADER"),1,0)) |>
filter(aux==1) |>
select(-intento_cader, -intento_directo, -aux)
## Main loop----
treshold = .70
entidades = unique(toupper(df_np$entidad_federativa))
i=1
dicc.df <- tibble()
for(entidad in entidades){
df.nc <- caders |> filter(estado==entidad)
df.np.i <- df_np |>
filter(entidad_federativa==entidad, lugar_de_trabajo=="CADER") |>
distinct(extraido, nom_cader, email_address)
for(j in 1:nrow(df.np.i)){
idd.b <- stringsim(df.np.i$extraido[j], df.nc$nombre_del_cader_vs_cab, method="jw") > treshold
idd.m <- which.max(stringsim(df.np.i$extraido[j], df.nc$nombre_del_cader_vs_cab, method="jw"))
index <- ifelse(idd.b[idd.m], idd.m, NA)
dicc.df[i, "adscripcion"] <- df.np.i$extraido[j]
dicc.df[i, "cader"] <- ifelse(is.na(index), NA, df.nc$nombre_del_cader_vs_cab[index])
dicc.df[i, "entidad"] <- entidad
dicc.df[i, "email_address"] <- df.np.i$email_address[j]
dicc.df[i, "nom_cader"] <- df.np.i$nom_cader[j]
dicc.df[i, "latitud"] <- ifelse(is.na(index), NA, df.nc$latitud[index])
dicc.df[i, "longitud"] <- ifelse(is.na(index), NA, df.nc$longitud[index])
dicc.df[i, "oref"] <- ifelse(is.na(index), NA, df.nc$sigla_edo_of_rep[index])
i=i+1
}
}
## Clean resulted data frame----
dicc.fn <-  dicc.df |>
distinct(cader, nom_cader, latitud, longitud, oref, email_address) |>
filter(!is.na(cader))
# Generar una columna de nuevos estados para agregar la Región Lagunera.
relacion <- dicc.fn |> distinct(cader, latitud, longitud, oref, email_address)
df <- df |> left_join(relacion) |>
mutate(entidad_federativa_2 = case_when(oref =="RG" ~ "Región Lagunera",
.default = entidad_federativa))
df_ff <- df |>
mutate(nom_cader = stri_trans_general(toupper(str_trim(nombre_del_cader_ddr_u_oref_donde_labora)), "latin-ascii")) |>
left_join(dicc.fn) |>
group_by(cader, latitud, longitud, entidad_federativa_2) |>
summarise(n=n(),
promedio=mean(score)) |>
mutate(longitud = as.numeric(longitud),
flag = "Con respuestas") |>
filter(!is.na(longitud)) |>
ungroup()
caders <- caders |>
mutate(entidad_federativa_2 = case_when(sigla_edo_of_rep == "RG" ~ "Región Lagunera",
.default = entidad_federativa))
df_ff <- left_join(caders, df_ff, join_by(entidad_federativa_2, nombre_del_cader_vs_cab==cader), suffix = c("", ".y"))
df_ff$flag <- ifelse(is.na(df_ff$flag), "Sin respuestas recibidas", df_ff$flag)
# Resultados agregados
df.resumen <- df |>
group_by(entidad_federativa_2) |>
summarise(across(p_1:p_22, \(x) sum(x, na.rm = T)),
mean_agri = mean(agricola, na.rm=T),
mean_pec = mean(pecuario, na.rm=T))
n.states <- df |>
group_by(entidad_federativa_2) |>
count()
df.resumen <- left_join(df.resumen, n.states)
df.resumen <- df.resumen |>
mutate(across(c(p_1:p_22), \(x) x/n, .names = "{.col}_"))
df.means <- df |>
group_by(treatment, modalidad) |>
summarise(mean=mean(score),
median=median(score),
sd=sd(score),
n=n(), .groups = 'drop')
df.hm <- df.resumen |> select(entidad_federativa_2, p_1_:p_22_) |>
pivot_longer(cols = c(p_1_:p_22_), names_to = "pregunta", values_to = "porcentaje")
# Objetos para la pestaña de Crosstalk
df.means.state <- df |>
group_by(treatment, entidad_federativa_2, modalidad) |>
summarise(mean=mean(score), sd=sd(score), n=n(), .groups = 'drop')
df.score <- SharedData$new(df, key = ~entidad_federativa_2, group = "estado_r")
df.score.state <- SharedData$new(df.means.state, key = ~entidad_federativa_2, group = "estado_r")
df.score.ent <- df |>
group_by(modalidad, entidad_federativa_2) |>
count()
df.score.ent <- SharedData$new(df.score.ent, key = ~entidad_federativa_2, group = "estado_r")
df.score.ent |>
plot_ly(labels = ~modalidad, values = ~n, type="pie",
marker = list(colors = c('#0062B8', '#4CA2D6', '#003A70', '#8AC3E6'))) |>
layout(xaxis = list(showgrid = FALSE, zeroline = FALSE, showticklabels = FALSE),
yaxis = list(showgrid = FALSE, zeroline = FALSE, showticklabels = FALSE))
# Clean environment
rm(list=ls())
# Read libraries----
library(pacman)
p_load(openxlsx, tidyverse, janitor, stringr, stringi,
here,
zoo,
lubridate,
cronR # This package schedules dates to run R scripts.
)
# Path in FAO Workspace----
path.fao <- "/Users/miguelrosales/Library/CloudStorage/OneDrive-FoodandAgricultureOrganization/FAO Mexico Workspace - UTF MEX 162 SIAP/04 Consultores/"
#First, define current date.
today <- Sys.Date()
#today <- as_date("2026-05-10")
# Second, define a group of dates to update sheets of excel document
dates_biweek <- seq.Date(from = as_date("2026-01-15"),
to = as_date("2026-10-15"),
by="1 month")
dates_lastday <- seq.Date(from = as_date("2026-01-01"),
to = as_date("2026-10-01"),
by = "1 month")
dates_lastday <- dates_lastday-days(1)
# Concatenate both vectors and arrange it.
dates <- c(dates_biweek, dates_lastday)[order(c(dates_biweek, dates_lastday))]
# OBSERVATION: We know that every excel has the same structure
## We sum one to the variable due to there is a sheet of 'example'
index <- max(which(today > dates))+1
index <- ifelse(is.infinite(index), 2, index)
index <- ifelse(index>21, 21, index)
index_plus <- ifelse(index+1 <21, index+1, 21)
index_plus_2 <- index_plus+1
index_complement <- which(!1:21 %in% c(1, index_plus_2, index_plus))
# Reade each direction, get excel, and show just recent sheet
paths.folders <- list.dirs(here("Reportes Técnicos"), full.names = F)
#Generate data frame for status of reports
df.status <- tibble(nombre=NA, estatus=NA,
actividades_planeadas = NA,
actividades_realizadas = NA,
comentarios=NA, fecha=NA)
# Loop
i=3
for(i in 2:length(paths.folders)){
# Read workbook to edit.
wb <- loadWorkbook(here("Reportes Técnicos", paths.folders[i], "Bitacora_Planeacion_y_reporte.xlsx"))
# Read workbook to make a back
wb.r <- loadWorkbook(here("Reportes Técnicos", paths.folders[i], "Bitacora_Planeacion_y_reporte.xlsx"))
fecha <- names(wb)[index]
# Identify an empty excel document (without activities)
df <- read.xlsx(here("Reportes Técnicos", paths.folders[i], "Bitacora_Planeacion_y_reporte.xlsx"),
startRow = 7,
sheet =fecha) |>
clean_names()
#Save data to generate a concentrate of all reports
nombre <- paths.folders[i]
estatus <- ifelse(length(unique(df$actividades))==length(which(is.na(unique(df$actividades)))), "No llenó", "Sí llenó")
actividades_planeadas <- sum(!is.na(df$actividades))
actividades_realizadas <- sum(!is.na(df$actividades_2))
comentarios <- ifelse(length(which(is.na(unique(df$comentarios)))) == 1, "Sin comentarios", "Con comentarios")
fecha <- names(wb)[index]
# Add row to data frame
df.status <- add_row(df.status, nombre=nombre,
estatus=estatus,
actividades_planeadas=actividades_planeadas,
actividades_realizadas=actividades_planeadas,
comentarios=comentarios,
fecha=fecha)
#Hide not current dates
sheetVisibility(wb)[c(index_complement)] <- 'hidden'
sheetVisibility(wb)[c(1, index_plus, index_plus_2)] <- TRUE
#Show all sheets in wb.r
sheetVisibility(wb.r)[c(1:21)] <- TRUE
#Save workbooks
saveWorkbook(wb, here("Reportes Técnicos", paths.folders[i], "Bitacora_Planeacion_y_reporte.xlsx"), overwrite = T)
saveWorkbook(wb.r, here("Respaldos", paths.folders[i], "Bitacora_Planeacion_y_reporte.xlsx"), overwrite = T)
# Save worknook in FAO sharepoint
path.final.i <- paste0(path.fao, paths.folders[i], "/Bitacora_Planeacion_y_reporte.xlsx")
saveWorkbook(wb.r, path.final.i, overwrite = T)
message(paste("Carpeta de ", paths.folders[i], " completada."))
}
# Clean environment
rm(list=ls())
# Read libraries----
library(pacman)
